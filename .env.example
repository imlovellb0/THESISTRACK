# Settings for a LIVE site. Copy these into your host's "environment variables" screen
# (or into a .env file on the server). Never commit real values to git.

NODE_ENV=production
PORT=3000

# Long random text. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# MySQL (use the values your host or database provider gives you)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=thesistrack
# DB_SSL=true            # turn on if your provider requires an encrypted connection

# Folder for uploaded chapters and ID photos. Must be a persistent disk on the host.
# UPLOAD_DIR=/var/data/uploads

# First coordinator account, created on the first start when none exists.
# Remove ADMIN_PASSWORD after signing in, then change your password.
ADMIN_NAME=Thesis Coordinator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email for adviser invitation codes (Gmail needs an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# The system administrator manages every workspace (sign in at /system/login).
# Remove SUPERADMIN_PASSWORD after signing in, then change your password.
SUPERADMIN_NAME=System Administrator
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
