<%- include('partials/header') %>
<%- include('partials/back', { href: '/', label: 'Back', hist: true }) %>
<div class="pagehead"><h1>Notifications</h1><span class="muted small" id="newtotal"><%= items.filter(n => !n.is_read).length %> new</span></div>
<%
  const SECTIONS = [
    { key: 'adviser', title: 'From your adviser', mine: 'From advisers' },
    { key: 'coordinator', title: 'From the coordinator', mine: 'From the coordinator' },
    { key: 'student', title: 'From your group', mine: 'From students' },
    { key: 'panel', title: 'From the panel', mine: 'From the panel' },
    { key: 'system', title: 'Reminders', mine: 'Reminders' },
  ];
  const known = SECTIONS.map((s) => s.key);
  const groups = SECTIONS.map((s) => ({ ...s, rows: items.filter((n) => (known.includes(n.source) ? n.source : 'system') === s.key) })).filter((g) => g.rows.length);
%>
<% if (!items.length) { %><section class="card"><p class="muted">Nothing yet. You will see submissions, reviews, deadlines and schedules here.</p></section><% } %>
<% groups.forEach((g) => { %>
<% const fresh = g.rows.filter(n => !n.is_read).length; %>
<details class="card notif-group notif-<%= g.key %>" data-source="<%= g.key %>" data-fresh="<%= fresh %>">
  <summary class="notif-title"><span class="notif-name"><%= user.role === 'student' ? g.title : g.mine %></span> <span class="notif-count"><%= g.rows.length %></span><% if (fresh) { %> <span class="badge" aria-label="<%= fresh %> unread"><%= fresh %></span><% } %></summary>
  <% g.rows.forEach((n) => { %>
    <div class="notif <%= !n.is_read ? 'unread' : '' %>">
      <%
        let parts = String(n.message).split('\n');
        // Older declines were saved as one sentence; split them at "Reason:" too.
        if (parts.length === 1) { const k = parts[0].indexOf(' Reason: '); if (k > -1) parts = [parts[0].slice(0, k), parts[0].slice(k + 1)]; }
        const head = parts[0], extra = parts.slice(1).join('\n');
      %>
      <span>
        <% if (n.link) { %><a href="<%= n.link %>"><%= head %></a><% } else { %><%= head %><% } %>
        <% if (extra) { %><span class="notif-detail"><%= extra %></span><% } %>
      </span>
      <div class="small muted"><% if (n.cls) { %><b><%= n.cls %></b> · <% } %><%= L.fmtDateTime(n.created_at) %></div>
    </div>
  <% }) %>
</details>
<% }) %>
<script>
// Opening a group marks its notifications read and takes down the red counters. The highlighted rows stay until you leave the page.
(function () {
  var csrf = '<%= csrf %>';
  document.querySelectorAll('details.notif-group').forEach(function (d) {
    d.addEventListener('toggle', function () {
      if (!d.open || d.dataset.fresh === '0') return;
      var fresh = Number(d.dataset.fresh);
      d.dataset.fresh = '0';
      var body = new URLSearchParams({ _csrf: csrf, source: d.dataset.source });
      fetch('/notifications/read', { method: 'POST', body: body, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var b = d.querySelector('summary .badge'); if (b) b.remove();
          var total = document.getElementById('newtotal'); if (total) total.textContent = data.unread + ' new';
          var bell = document.getElementById('bellcount');
          if (bell) { if (data.unread) bell.textContent = data.unread; else bell.remove(); }
        })
        .catch(function () { d.dataset.fresh = String(fresh); });
    });
  });
})();
</script>
<%- include('partials/footer') %>
