<script>
(function () {
  var cv = document.getElementById('authbg');
  if (!cv || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var ctx = cv.getContext('2d'), W, H, dots = [], mouse = { x: -999, y: -999 };
  function size() {
    var r = window.devicePixelRatio || 1;
    W = cv.width = innerWidth * r; H = cv.height = innerHeight * r;
    cv.style.width = innerWidth + 'px'; cv.style.height = innerHeight + 'px';
    ctx.setTransform(r, 0, 0, r, 0, 0);
    var n = Math.min(70, Math.round(innerWidth * innerHeight / 18000));
    dots = [];
    for (var i = 0; i < n; i++) dots.push({ x: Math.random() * innerWidth, y: Math.random() * innerHeight, vx: (Math.random() - .5) * .5, vy: (Math.random() - .5) * .5 });
  }
  addEventListener('resize', size);
  addEventListener('mousemove', function (e) { mouse.x = e.clientX; mouse.y = e.clientY; });
  function frame() {
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    for (var i = 0; i < dots.length; i++) {
      var d = dots[i];
      d.x += d.vx; d.y += d.vy;
      if (d.x < 0 || d.x > innerWidth) d.vx *= -1;
      if (d.y < 0 || d.y > innerHeight) d.vy *= -1;
      var mx = d.x - mouse.x, my = d.y - mouse.y, md = Math.sqrt(mx * mx + my * my);
      if (md < 120) { d.x += mx / md * 1.2; d.y += my / md * 1.2; }
      ctx.fillStyle = 'rgba(194,162,77,.8)';
      ctx.beginPath(); ctx.arc(d.x, d.y, 2, 0, 6.283); ctx.fill();
      for (var j = i + 1; j < dots.length; j++) {
        var dx = d.x - dots[j].x, dy = d.y - dots[j].y, dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 140) {
          ctx.strokeStyle = 'rgba(143,174,240,' + (.35 * (1 - dist / 140)) + ')';
          ctx.beginPath(); ctx.moveTo(d.x, d.y); ctx.lineTo(dots[j].x, dots[j].y); ctx.stroke();
        }
      }
    }
    if (!document.hidden) requestAnimationFrame(frame); else setTimeout(frame, 500);
  }
  size(); frame();

  // card tilts gently toward the pointer
  var card = document.querySelector('.authwrap .card');
  if (card && matchMedia('(hover: hover)').matches) {
    addEventListener('mousemove', function (e) {
      var r = card.getBoundingClientRect(),
          x = (e.clientX - (r.left + r.width / 2)) / innerWidth, y = (e.clientY - (r.top + r.height / 2)) / innerHeight;
      card.style.setProperty('--mx', (e.clientX - r.left) + 'px'); card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      card.style.transform = 'rotateY(' + (x * 8) + 'deg) rotateX(' + (-y * 8) + 'deg)';
    });
  }
})();
</script>
<script>
(function () {
  var KEY = 'thesistrack.email', email = document.querySelector('input[name="email"]'),
      box = document.getElementById('rememberemail'), pw = document.querySelector('input[name="password"]');
  if (!email || !box) return;
  try {
    var saved = localStorage.getItem(KEY);
    if (saved) { email.value = saved; box.checked = true; if (pw) pw.focus(); }
  } catch (e) {}
  email.form.addEventListener('submit', function () {
    try {
      if (box.checked) localStorage.setItem(KEY, email.value.trim());
      else localStorage.removeItem(KEY);
    } catch (e) {}
  });
})();
</script>
<script>
(function () {
  var flock = document.querySelector('.flock'), sel = document.getElementById('rolepick');
  if (!flock || !sel || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var busy = false;
  function scare() {
    if (busy) return;
    busy = true;
    flock.className = 'flock fly';
    setTimeout(function () {
      flock.className = 'flock back';
      setTimeout(function () { flock.className = 'flock'; busy = false; }, 2300);
    }, 4000);
  }
  sel.addEventListener('roleopen', scare);
})();
</script>
<script>
(function () {
  var pick = document.getElementById('rolepick'), btn = document.getElementById('rolebtn'), list = document.getElementById('rolelist'),
      input = document.getElementById('roleinput'), label = document.getElementById('rolevalue');
  if (!pick) return;
  var options = Array.prototype.slice.call(list.querySelectorAll('[role="option"]')), closeTimer = null, picked = false, active = -1;

  function setActive(i) {
    active = i;
    options.forEach(function (o, n) { o.classList.toggle('active', n === i); });
    if (i >= 0) btn.setAttribute('aria-activedescendant', options[i].id); else btn.removeAttribute('aria-activedescendant');
  }
  function open() {
    clearTimeout(closeTimer);
    if (pick.classList.contains('open')) return;
    pick.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
    setActive(Math.max(0, options.findIndex(function (o) { return o.getAttribute('data-value') === input.value; })));
    pick.dispatchEvent(new Event('roleopen'));
  }
  function close() {
    clearTimeout(closeTimer);
    pick.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
    setActive(-1);
  }
  function choose(o) {
    input.value = o.getAttribute('data-value');
    label.textContent = o.textContent;
    label.classList.remove('placeholder');
    options.forEach(function (x) { x.setAttribute('aria-selected', x === o ? 'true' : 'false'); });
    picked = true; // stay closed until the pointer leaves, so the list does not pop open again under it
    close();
    var next = document.querySelector('input[name="email"]');
    if (next && !next.value) next.focus();
  }

  // Hovering the control with a mouse shows the roles. A short delay lets the pointer travel from the button to the list.
  pick.addEventListener('pointerenter', function (e) { if (e.pointerType !== 'touch' && !picked) open(); });
  pick.addEventListener('pointerleave', function (e) { if (e.pointerType === 'touch') return; picked = false; closeTimer = setTimeout(close, 150); });
  // Touch screens have no hover, so tapping the button toggles the list. A mouse click just keeps it open.
  var lastPointer = '';
  btn.addEventListener('pointerdown', function (e) { lastPointer = e.pointerType; });
  btn.addEventListener('click', function () {
    var wasMouse = lastPointer && lastPointer !== 'touch';
    lastPointer = '';
    if (wasMouse) { picked = false; open(); return; }
    if (pick.classList.contains('open')) close(); else { picked = false; open(); }
  });
  options.forEach(function (o) { o.addEventListener('click', function () { choose(o); }); });
  document.addEventListener('click', function (e) { if (!pick.contains(e.target)) close(); });

  btn.addEventListener('keydown', function (e) {
    var k = e.key;
    if (k === 'ArrowDown' || k === 'ArrowUp') {
      e.preventDefault();
      picked = false;
      if (!pick.classList.contains('open')) { open(); return; }
      setActive((active + (k === 'ArrowDown' ? 1 : -1) + options.length) % options.length);
    } else if ((k === 'Enter' || k === ' ') && pick.classList.contains('open') && active >= 0) {
      e.preventDefault();
      choose(options[active]);
    } else if (k === 'Escape' || k === 'Tab') {
      close();
    }
  });

  // The hidden field cannot be "required", so check it here.
  pick.closest('form').addEventListener('submit', function (e) {
    if (input.value) return;
    e.preventDefault();
    picked = false;
    btn.focus();
    open();
  });
})();
</script>
