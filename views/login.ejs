<script>
// eagles wander the whole sky in profile, turning slowly toward random waypoints
(function () {
  var box = document.getElementById('eagles');
  if (!box) return;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches, birds = [];
  [].forEach.call(box.querySelectorAll('.eagle'), function (el, i) {
    var b = { el: el, w: el.offsetWidth, x: Math.random() * innerWidth, y: innerHeight * (.1 + .15 * i), a: Math.random() * 6.28,
              v: 26 + Math.random() * 18, dir: 1, tx: 0, ty: 0 };
    birds.push(b);
  });
  function aim(b) { b.tx = innerWidth * (.04 + Math.random() * .92); b.ty = innerHeight * (.05 + Math.random() * .55); }
  birds.forEach(aim);
  var last = performance.now();
  function frame(now) {
    var dt = Math.min(.1, (now - last) / 1000); last = now;
    birds.forEach(function (b) {
      var want = Math.atan2(b.ty - b.y, b.tx - b.x), d = want - b.a;
      d = Math.atan2(Math.sin(d), Math.cos(d));
      b.a += Math.max(-.45 * dt, Math.min(.45 * dt, d));
      b.x += Math.cos(b.a) * b.v * dt; b.y += Math.sin(b.a) * b.v * dt;
      if (Math.abs(b.tx - b.x) + Math.abs(b.ty - b.y) < 90) aim(b);
      var bank = Math.max(-.3, Math.min(.3, d * .6));
      b.el.style.transform = 'translate(' + (b.x - b.w / 2).toFixed(1) + 'px,' + (b.y - b.w / 6).toFixed(1) + 'px) rotate(' + bank.toFixed(3) + 'rad)';
    });
    if (!reduce) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>
<script>
// The sun is the page clock: it rises at 6:00, peaks at noon and sets at 18:00 (visitor's local time); a moon takes over at night.
(function () {
  var sky = document.getElementById('sky'), sun = document.getElementById('sun'), moon = document.getElementById('moon');
  if (!sky || !sun || !moon) return;
  var STOPS = [ // hour, sky top, sky bottom
    [0, [5, 11, 31], [14, 27, 61]], [5, [11, 21, 48], [42, 47, 92]], [6, [59, 74, 138], [242, 166, 90]],
    [8, [74, 134, 214], [169, 208, 240]], [12, [47, 127, 224], [140, 196, 245]], [16, [74, 134, 214], [182, 211, 238]],
    [18, [82, 73, 127], [240, 136, 74]], [19, [29, 35, 80], [107, 63, 110]], [20.5, [11, 21, 48], [26, 36, 72]], [24, [5, 11, 31], [14, 27, 61]]
  ];
  function lerp(a, b, t) { return a + (b - a) * t; }
  function mix(a, b, t) { return [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)].map(Math.round); }
  function rgb(c, a) { return a == null ? 'rgb(' + c.join(',') + ')' : 'rgba(' + c.join(',') + ',' + a + ')'; }
  function paint(h) {
    var i = 0; while (i < STOPS.length - 2 && h >= STOPS[i + 1][0]) i++;
    var a = STOPS[i], b = STOPS[i + 1], t = (h - a[0]) / (b[0] - a[0]);
    sky.style.setProperty('--sky-top', rgb(mix(a[1], b[1], t)));
    sky.style.setProperty('--sky-bot', rgb(mix(a[2], b[2], t)));
    sky.style.setProperty('--stars', h < 5.5 || h > 19.5 ? 1 : h < 7 ? (7 - h) / 1.5 : h > 18 ? (h - 18) / 1.5 : 0);
    var night = h < 5 || h > 20;
    var hills = document.querySelector('.hills');
    hills.style.setProperty('--hill-far', night ? '#141f3a' : '#1d3254');
    var rv = document.querySelector('.river');
    rv.style.setProperty('--rv-a', rgb(mix(mix(a[2], b[2], t), [255, 255, 255], .12)));
    rv.style.setProperty('--rv-b', rgb(mix(mix(a[1], b[1], t), [20, 70, 120], .55)));
    var scene = document.querySelector('.mtns');
    scene.style.setProperty('--mtn-a', night ? '#1a2a4a' : '#35527c');
    scene.style.setProperty('--mtn-b', night ? '#142340' : '#2a4468');
    document.getElementById('eagles').style.setProperty('--eagle-op', night ? .25 : .9);
    // Clouds take the colour of the sky near the horizon (warm at sunset) and fade to dim grey-blue at night.
    var cl = document.getElementById('clouds'), dark = h < 5.5 || h > 19.5;
    cl.style.setProperty('--cloud-c', rgb(mix(mix(a[2], b[2], t), [255, 255, 255], dark ? .22 : .8)));
    cl.style.setProperty('--cloud-op', dark ? .5 : .92);
    document.querySelector('.hut .win').parentNode.style.setProperty('--hut-light', h > 17.5 || h < 5.5 ? '#ffc766' : '#2a1d10');
    hills.style.setProperty('--hill-near', night ? '#0a1224' : '#0f1d36');
  }
  function place(el, p, scale) { // p 0..1 across the sky; arc peaks at the middle
    var w = innerWidth, h = innerHeight, horizon = h * .86, peak = h * .16;
    var x = w * (.06 + .88 * p), y = horizon - Math.sin(Math.PI * p) * (horizon - peak);
    el.style.transform = 'translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px) scale(' + scale.toFixed(3) + ')';
  }
  function tick() {
    var q = new URLSearchParams(location.search).get('sunhour'), d = new Date(),
        h = q !== null && !isNaN(+q) ? +q % 24 : d.getHours() + d.getMinutes() / 60 + d.getSeconds() / 3600;
    paint(h);
    var day = h >= 6 && h < 18, p = day ? (h - 6) / 12 : ((h >= 18 ? h - 18 : h + 6) / 12);
    var low = 1 - Math.sin(Math.PI * Math.min(Math.max(p, 0), 1)); // 1 at the horizon, 0 at noon
    sun.style.opacity = day ? 1 : 0; moon.style.opacity = day ? 0 : 1;
    if (day) {
      var core = mix([255, 251, 230], [255, 190, 120], low), mid = mix([255, 226, 122], [255, 140, 60], low), edge = mix([255, 157, 46], [230, 70, 30], low);
      sun.style.setProperty('--sun-core', rgb(core)); sun.style.setProperty('--sun-mid', rgb(mid)); sun.style.setProperty('--sun-edge', rgb(edge));
      sun.style.setProperty('--sun-glow', rgb(mix([255, 215, 110], [255, 120, 50], low), .7));
      sun.style.setProperty('--sun-halo', rgb(mix([255, 190, 80], [255, 90, 40], low), .35));
      sun.style.setProperty('--sun-ray', rgb(mix([255, 235, 160], [255, 170, 100], low), .22));
      place(sun, p, 1 + .4 * low);
    } else place(moon, p, 1);
  }
  tick(); setInterval(tick, 20000); addEventListener('resize', tick);
})();
</script>
