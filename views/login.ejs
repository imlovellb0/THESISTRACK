            <ellipse class="belly" cx="17" cy="19" rx="7" ry="4"/>
            <circle class="body" cx="25" cy="10" r="6"/>
            <path class="beak" d="M30 9 L35.5 11 L30 12.5 Z"/>
            <circle cx="27" cy="8.6" r="1.1" fill="#16213A"/>
            <path class="wing" d="M9 13 Q16 6 23 14 Q16 20 9 16 Z"/>
            <path d="M13 22 V26.5 M18 22 V26.5" stroke="#16213A" stroke-width="1.2" stroke-linecap="round"/>
          </svg></span>
