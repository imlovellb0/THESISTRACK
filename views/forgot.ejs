<%- include('partials/header') %>
<div class="authwrap">
  <section class="card">
    <h1>Forgot your password?</h1>
    <% if (typeof error !== 'undefined') { %><div class="flash error"><%= error %></div><% } %>
    <% if (sent) { %>
      <div class="flash ok">If that email belongs to an active account, a reset link was created. It works once and expires in 30 minutes.</div>
      <% if (!mailReady) { %><p class="small muted">Email is not set up on this system yet, so no message can arrive. The system administrator was told about your request and can reset your password for you.</p><% } %>
      <p class="small"><a href="/login">Back to sign in</a></p>
    <% } else { %>
      <p class="small muted">Enter the email you registered with. We will send a link to choose a new password. If you cannot get the email, the system administrator can reset your password.</p>
      <form class="stack" method="post" action="/forgot">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="field"><span>Email</span><input type="email" name="email" autocomplete="username" required autofocus></label>
        <button class="btn primary" type="submit">Send reset link</button>
      </form>
      <p class="small"><a href="/login">Back to sign in</a></p>
    <% } %>
  </section>
</div>
<%- include('partials/footer') %>
