<%- include('partials/header') %>
<div class="authwrap">
  <section class="card">
<%- include('partials/back', { href: '/login', label: 'Back to sign in' }) %>
    <h1>Forgot your password?</h1>
    <% if (typeof error !== 'undefined') { %><div class="flash error"><%= error %></div><% } %>
    <% if (step === 'code') { %>
      <div class="flash ok">If that email belongs to an active account, a 6-digit code was sent to it. The code works once and only for <%= seconds %> seconds.</div>
      <% if (!mailReady) { %><p class="small muted">Email is not set up on this system yet, so no message can arrive. The system administrator was told about your request and can reset your password for you.</p><% } %>
      <form class="stack" method="post" action="/forgot/reset">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="email" value="<%= email %>">
        <label class="field"><span>6-digit code</span><input type="text" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus></label>
        <label class="field"><span>New password <span class="hint">(at least 8 characters)</span></span><input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
        <label class="field"><span>Confirm new password</span><input type="password" name="confirm" autocomplete="new-password" minlength="8" required></label>
        <button class="btn primary" type="submit">Change password</button>
      </form>
      <form method="post" action="/forgot" class="small">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="email" value="<%= email %>">
        Code expired or not received? <button class="linklike" type="submit">Send a new code</button>
      </form>
    <% } else { %>
      <p class="small muted">Enter the email you registered with. We will send a 6-digit code, and you enter it on the next step with your new password. If you cannot get the email, the system administrator can reset your password.</p>
      <form class="stack" method="post" action="/forgot">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="field"><span>Email</span><input type="email" name="email" value="<%= email %>" autocomplete="username" required autofocus></label>
        <button class="btn primary" type="submit">Send code</button>
      </form>
    <% } %>
    <p class="small"><a href="/login">Back to sign in</a></p>
  </section>
</div>
<%- include('partials/footer') %>
