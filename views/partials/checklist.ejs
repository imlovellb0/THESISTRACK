<%# First steps for a new student. Pass steps (from L.checklist). %>
<ol class="checklist">
  <% steps.forEach((s, i) => { %>
    <li class="<%= s.done ? 'done' : '' %>"><span class="tick" aria-hidden="true"><%= s.done ? '✓' : i + 1 %></span>
      <% if (!s.done && s.href) { %><a href="<%= s.href %>"><%= s.label %></a><% } else { %><span><%= s.label %></span><% } %>
      <% if (s.done) { %><span class="sr">done</span><% } %></li>
  <% }) %>
</ol>
