<%- include('../partials/header') %>
<% const qs = (p) => `?q=${encodeURIComponent(q)}&workspace=${workspace}&page=${p}`; %>
<div class="pagehead"><h1>Groups</h1><span class="muted small"><%= total %> group<%= total === 1 ? '' : 's' %> across all workspaces. Read-only: coordinators manage their own groups.</span></div>
<section class="card">
  <form class="filterbar" method="get" action="/system/groups">
    <label class="field"><span>Search</span><input type="search" name="q" value="<%= q %>" placeholder="Group name or thesis title"></label>
    <label class="field" style="min-width:11rem;flex:0"><span>Workspace</span><select name="workspace"><option value="">All</option>
      <% workspaces.forEach(w => { %><option value="<%= w.id %>" <%= String(w.id) === workspace ? 'selected' : '' %>><%= w.name %></option><% }) %></select></label>
    <button class="btn" type="submit">Filter</button>
  </form>
  <div class="tablewrap"><table>
    <thead><tr><th>Group</th><th>Workspace</th><th>Adviser</th><th class="num">Members</th><th>Progress</th><th>Health</th></tr></thead>
    <tbody>
    <% groups.forEach(g => { %>
      <tr>
        <td><b><%= g.name %></b><br><span class="small muted"><%= g.title %></span><% if (L.classLabel(g)) { %><br><span class="small"><%= L.classLabel(g) %></span><% } %></td>
        <td><a href="/system/workspaces/<%= g.workspace_id %>"><%= g.workspace_name %></a></td>
        <td><%= g.adviser_name || '' %><% if (!g.adviser_name) { %><span class="pill warn">Not assigned</span><% } %></td>
        <td class="num"><%= g.member_count %></td>
        <td><%- L.bar(g.approved, g.chapters.length) %></td>
        <td><%- L.hpill(g.health) %> <%- L.readyPill(g.readiness) %></td>
      </tr>
    <% }) %>
    <% if (!groups.length) { %><tr><td colspan="6" class="muted">No matching groups.</td></tr><% } %>
    </tbody>
  </table></div>
  <% if (pages > 1) { %>
  <p class="small">
    <% if (page > 1) { %><a href="<%= qs(page - 1) %>">&larr; Previous</a><% } %>
    Page <%= page %> of <%= pages %>
    <% if (page < pages) { %><a href="<%= qs(page + 1) %>">Next &rarr;</a><% } %>
  </p>
  <% } %>
</section>
<%- include('../partials/footer') %>
