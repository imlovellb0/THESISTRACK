<%- include('../partials/header') %>
<div class="pagehead"><h1><%= ws.name %></h1><a class="small" href="/system/workspaces">&larr; All workspaces</a></div>
<div class="stats">
  <a class="stat link" href="/system/users?role=student&workspace=<%= ws.id %>"><b><%= counts.students %></b><span>Students</span></a>
  <a class="stat link" href="/system/users?role=adviser&workspace=<%= ws.id %>"><b><%= staff.filter(s => s.role === 'adviser').length %></b><span>Advisers</span></a>
  <a class="stat link" href="/system/users?role=panel&workspace=<%= ws.id %>"><b><%= counts.panel %></b><span>Panel members</span></a>
  <a class="stat link" href="/system/groups?workspace=<%= ws.id %>"><b><%= counts.groups %></b><span>Groups</span></a>
  <div class="stat"><b><%= counts.files %></b><span>Files</span></div>
</div>
<% if (typeof error !== 'undefined') { %><div class="flash error"><%= error %></div><% } %>
<div class="layout">
<div class="col">
  <section class="card">
    <header><h2>Coordinators and advisers</h2></header>
    <div class="tablewrap"><table>
      <thead><tr><th>Name</th><th>Role</th><th>Email</th><th></th></tr></thead>
      <tbody>
      <% staff.forEach(s => { %>
        <tr>
          <td><a href="/system/users/<%= s.id %>"><%= s.name %></a><% if (!s.active) { %> <span class="pill">Inactive</span><% } %></td>
          <td><%= L.ROLE_LABEL[s.role] %></td><td class="mono"><%= s.email %></td>
          <td><a class="btn sm" href="/system/users/<%= s.id %>">Manage</a></td>
        </tr>
      <% }) %>
      <% if (!staff.length) { %><tr><td colspan="4" class="muted">Nobody yet. Add a coordinator below.</td></tr><% } %>
      </tbody>
    </table></div>
    <p class="small muted">Students and panel members are listed under <a href="/system/users?workspace=<%= ws.id %>">Users</a>.</p>
  </section>
  <section class="card">
    <header><h2>Add a coordinator</h2></header>
    <form class="stack" method="post" action="/system/workspaces/<%= ws.id %>/coordinators">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><span>Full name</span><input type="text" name="name" value="<%= form.name || '' %>" required></label>
      <label class="field"><span>Email</span><input type="email" name="email" value="<%= form.email || '' %>" required></label>
      <label class="field"><span>Starting password <span class="hint">(at least 8 characters)</span></span><input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
      <button class="btn primary" type="submit">Add coordinator</button>
    </form>
  </section>
  <% if (request && request.status === 'Pending') { %>
  <section class="card">
    <header><h2>Deletion request</h2><span class="pill warn">Pending</span></header>
    <p class="small"><b><%= request.requested_name %></b> asked on <%= L.fmtDate(request.created_at) %> to delete this workspace.</p>
    <p><b>Reason:</b> <%= request.reason %></p>
    <p class="small muted">It holds <%= counts.students %> student<%= counts.students === 1 ? '' : 's' %>, <%= counts.groups %> group<%= counts.groups === 1 ? '' : 's' %> and <%= counts.files %> uploaded file<%= counts.files === 1 ? '' : 's' %>. Approving suspends the workspace for <%= graceDays %> days. Nothing is erased until you delete it after that.</p>
    <form class="stack" method="post" action="/system/workspaces/<%= ws.id %>/deletion/approve">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><span>Note <span class="hint">(optional)</span></span><input type="text" name="note" maxlength="1000"></label>
      <button class="btn bad" type="submit" onclick="return confirm('Approve and suspend this workspace?')">Approve and suspend</button>
    </form>
    <form class="stack" method="post" action="/system/workspaces/<%= ws.id %>/deletion/reject">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><span>Note to the coordinator <span class="hint">(required to reject)</span></span><input type="text" name="note" maxlength="1000"></label>
      <button class="btn" type="submit">Reject the request</button>
    </form>
  </section>
  <% } else if (request && request.status === 'Approved') { %>
  <section class="card">
    <header><h2>Deletion approved</h2><span class="pill <%= request.in_grace ? 'warn' : 'bad' %>"><%= request.in_grace ? 'Grace period' : 'Ready to delete' %></span></header>
    <p class="small">Requested by <b><%= request.requested_name %></b> on <%= L.fmtDate(request.created_at) %>. Reason: <%= request.reason %></p>
    <% if (request.decision_note) { %><p class="small">Your note: <%= request.decision_note %></p><% } %>
    <p class="small"><%= request.in_grace ? 'The workspace is suspended. It can be permanently deleted after ' + L.fmtDate(request.delete_after) + '. Reactivate it under Status if the coordinator changed their mind.' : 'The grace period ended on ' + L.fmtDate(request.delete_after) + '. You can delete it permanently below.' %></p>
  </section>
  <% } else if (request && ['Rejected', 'Cancelled', 'Reversed'].includes(request.status)) { %>
  <section class="card">
    <header><h2>Last deletion request</h2><span class="pill"><%= request.status %></span></header>
    <p class="small">By <%= request.requested_name %> on <%= L.fmtDate(request.created_at) %>. Reason: <%= request.reason %></p>
    <% if (request.decision_note) { %><p class="small">Note: <%= request.decision_note %></p><% } %>
  </section>
  <% } %>
  <section class="card">
    <header><h2>Delete this workspace</h2></header>
    <div class="flash warn">This cannot be undone. It permanently deletes every account in the workspace (including ID photos), all groups, chapters, uploaded files, comments, consultations, announcements and its activity log. It holds <%= counts.students %> student<%= counts.students === 1 ? '' : 's' %>, <%= counts.groups %> group<%= counts.groups === 1 ? '' : 's' %> and <%= counts.files %> file<%= counts.files === 1 ? '' : 's' %>. To stop access without deleting anything, suspend it instead.</div>
    <% if (request && request.status === 'Approved' && request.in_grace) { %>
      <p class="small muted">Locked until <%= L.fmtDate(request.delete_after) %>.</p>
    <% } else { %>
    <form class="stack" method="post" action="/system/workspaces/<%= ws.id %>/delete">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><span>Type the workspace name to confirm: <b><%= ws.name %></b></span><input type="text" name="confirm_name" autocomplete="off" required></label>
      <label class="field"><span>Your password</span><input type="password" name="password" autocomplete="current-password" required></label>
      <button class="btn bad" type="submit" onclick="return confirm('Delete this workspace and all of its data permanently?')">Delete workspace permanently</button>
    </form>
    <% } %>
  </section>
</div>
<aside class="col">
  <section class="card">
    <header><h2>Status</h2><span class="pill <%= ws.active ? 'good' : 'bad' %>"><%= ws.active ? 'Active' : 'Suspended' %></span></header>
    <p class="small muted">A suspended workspace keeps all its data, but nobody in it can sign in and the join code stops working.</p>
    <form method="post" action="/system/workspaces/<%= ws.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit" <% if (ws.active) { %>onclick="return confirm('Suspend this workspace? Everyone in it will be locked out.')"<% } %>><%= ws.active ? 'Suspend workspace' : 'Reactivate workspace' %></button></form>
  </section>
  <section class="card">
    <header><h2>Name</h2></header>
    <form class="stack" method="post" action="/system/workspaces/<%= ws.id %>/rename"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><span>Workspace name</span><input type="text" name="name" value="<%= ws.name %>" maxlength="120" required></label>
      <button class="btn" type="submit">Rename</button></form>
  </section>
  <section class="card">
    <header><h2>Student join code</h2></header>
    <p><b class="mono" style="font-size:1.4rem;letter-spacing:.15em"><%= ws.join_code %></b></p>
    <form method="post" action="/system/workspaces/<%= ws.id %>/new-code"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn" type="submit" onclick="return confirm('Make a new code? The old one stops working.')">Make a new code</button></form>
  </section>
</aside>
</div>
<%- include('../partials/footer') %>
