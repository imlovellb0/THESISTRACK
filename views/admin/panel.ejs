<%- include('../partials/header') %>
<div class="pagehead"><h1>Panel members</h1><span class="muted small">Invite panelists with a one-time code. They register with it, then sign in to see the groups you assign them to.</span></div>
<% if (typeof error !== 'undefined') { %><div class="flash error"><%= error %></div><% } %>
<div class="layout">
<section class="card">
  <header><h2>All panel members</h2></header>
  <div class="tablewrap"><table>
    <thead><tr><th>Name</th><th>Email</th><th>Assigned to</th><th></th></tr></thead>
    <tbody>
    <% members.forEach(m => { %>
      <tr>
        <td>
          <form id="edit<%= m.id %>" method="post" action="/admin/panel/<%= m.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"></form>
          <input form="edit<%= m.id %>" type="text" name="name" value="<%= m.name %>" maxlength="255" required aria-label="Name">
          <% if (!m.active) { %><span class="pill">Inactive</span><% } %>
        </td>
        <td><input form="edit<%= m.id %>" type="email" name="email" value="<%= m.email %>" maxlength="190" required aria-label="Email"></td>
        <td class="small"><%= m.groups.length ? m.groups.join(', ') : 'No group yet' %></td>
        <td>
          <div class="row">
            <button class="btn sm primary" type="submit" form="edit<%= m.id %>">Save</button>
            <form method="post" action="/admin/panel/<%= m.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn sm" type="submit"><%= m.active ? 'Deactivate' : 'Activate' %></button></form>
            <form method="post" action="/admin/panel/<%= m.id %>/delete" onsubmit="return confirm('Remove <%= m.name.replace(/[\x27\\]/g, '') %> from the system and from every panel?')"><input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn sm bad" type="submit">Remove</button></form>
          </div>
        </td>
      </tr>
    <% }) %>
    <% if (!members.length) { %><tr><td colspan="4" class="muted">No panel members yet. Invite one on the right.</td></tr><% } %>
    </tbody>
  </table></div>
</section>

<div class="col">
<section class="card">
  <header><h2>Invite a panelist</h2></header>
  <form class="stack" method="post" action="/admin/panel/invite">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="field"><span>Full name</span><input type="text" name="name" value="<%= form.name || '' %>" maxlength="255" required></label>
    <label class="field"><span>Email <span class="hint">(an address the panelist can open)</span></span><input type="email" name="email" value="<%= form.email || '' %>" maxlength="190" required></label>
    <button class="btn primary" type="submit">Send invitation</button>
  </form>
  <p class="small muted">The panelist gets a 6-digit code by email that works for <%= ttl %> minutes. They open
    <a href="/register/panel">/register/panel</a>, enter their email and the code, and choose a password.</p>
  <% if (!mailReady) { %><p class="small"><span class="pill warn">Email not set up</span> Codes are saved to <span class="mono">outbox/mail.log</span> in the project folder instead of being emailed.</p><% } %>
</section>

<section class="card">
  <header><h2>Invitations</h2></header>
  <div class="tablewrap"><table>
    <thead><tr><th>Name</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% invites.forEach(i => { %>
      <tr>
        <td><%= i.name %><br><span class="small mono"><%= i.email %></span></td>
        <td><% if (i.status === 'Registered') { %><span class="pill good">Registered</span>
            <% } else if (i.status === 'Cancelled') { %><span class="pill">Cancelled</span>
            <% } else if (i.expired) { %><span class="pill warn">Code expired</span>
            <% } else { %><span class="pill info">Invited</span><% } %></td>
        <td>
          <% if (i.status === 'Invited') { %>
          <div class="row">
            <form method="post" action="/admin/panel/invite/<%= i.id %>/resend"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm" type="submit">Send a new code</button></form>
            <form method="post" action="/admin/panel/invite/<%= i.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm" type="submit">Cancel</button></form>
          </div>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (!invites.length) { %><tr><td colspan="3" class="muted">No invitations yet.</td></tr><% } %>
    </tbody>
  </table></div>
</section>
</div>
</div>
<%- include('../partials/footer') %>
